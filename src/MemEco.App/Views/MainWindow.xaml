<Window x:Class="MemEco.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MemEco.App.Views"
        Title="MemEco" Width="440" Height="680"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        ShowInTaskbar="False" WindowStartupLocation="Manual"
        Background="#FF0B111C" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                  CornerRadius="18" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
    <views:MainPanel />
  </Grid>
</Window>
