<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:MemEco.App.Presentation">

  <!-- ============================================================
       パレット / フォント
       ============================================================ -->
  <Color x:Key="BgTopColor">#FF0B111C</Color>
  <Color x:Key="BgBottomColor">#FF111A2B</Color>
  <Color x:Key="CardBorderColor">#FF243149</Color>
  <Color x:Key="TextColor">#FFE9EFF9</Color>
  <Color x:Key="SubTextColor">#FF8FA3BF</Color>
  <Color x:Key="MutedTextColor">#FF66799A</Color>
  <Color x:Key="MintColor">#FF4ADE80</Color>
  <Color x:Key="CyanColor">#FF22D3EE</Color>
  <Color x:Key="AmberColor">#FFFBBF24</Color>
  <Color x:Key="RedColor">#FFF87171</Color>
  <Color x:Key="TrackColor">#FF1D2941</Color>
  <Color x:Key="InputColor">#FF101A2A</Color>

  <FontFamily x:Key="FontText">Segoe UI Variable Text, Yu Gothic UI, Segoe UI, Meiryo UI</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Yu Gothic UI, Segoe UI</FontFamily>

  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="SubTextBrush" Color="{StaticResource SubTextColor}" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
  <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
  <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}" />
  <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
  <SolidColorBrush x:Key="RedBrush" Color="{StaticResource RedColor}" />
  <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
  <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
  <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="#FF1E2B45" />
  <SolidColorBrush x:Key="SegmentBgBrush" Color="#FF0F1828" />
  <SolidColorBrush x:Key="StatBgBrush" Color="#FF121C2E" />
  <SolidColorBrush x:Key="StatBorderBrush" Color="#FF1E2A41" />

  <LinearGradientBrush x:Key="PanelBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource BgTopColor}" Offset="0" />
    <GradientStop Color="{StaticResource BgBottomColor}" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0.55,1">
    <GradientStop Color="#FF17223A" Offset="0" />
    <GradientStop Color="#FF121B2D" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="{StaticResource MintColor}" Offset="0" />
    <GradientStop Color="{StaticResource CyanColor}" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="AccentGradientHorizontal" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="{StaticResource MintColor}" Offset="0" />
    <GradientStop Color="{StaticResource CyanColor}" Offset="1" />
  </LinearGradientBrush>

  <conv:EnumEqualsConverter x:Key="EnumEquals" />
  <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
  <BooleanToVisibilityConverter x:Key="BoolToVis" />

  <!-- ============================================================
       フォーカス
       ============================================================ -->
  <Style x:Key="FocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-2" BorderBrush="#CC7CF5BE" BorderThickness="1.5" CornerRadius="10" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       テキスト
       ============================================================ -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="PanelTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
  </Style>

  <Style x:Key="Caption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
  </Style>

  <Style x:Key="Number" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style x:Key="StatValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style x:Key="StatLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
  </Style>

  <Style x:Key="RingStatus" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding LevelKey}" Value="warning">
        <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding LevelKey}" Value="critical">
        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding LevelKey}" Value="nodata">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ============================================================
       カード
       ============================================================ -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource CardBackground}" />
    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Color="#FF000000" Opacity="0.32" />
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StatCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource StatBgBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource StatBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- ============================================================
       ボタン
       ============================================================ -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="#FF062018" />
    <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Border x:Name="Bg" CornerRadius="11" Background="{StaticResource AccentGradient}">
              <Border.Effect>
                <DropShadowEffect Color="#FF22D3EE" BlurRadius="16" ShadowDepth="0" Opacity="0.32" />
              </Border.Effect>
            </Border>
            <Border x:Name="Hover" CornerRadius="11" Background="#FFFFFFFF" Opacity="0" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="0.13" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Hover" Property="Opacity" Value="0.22" />
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True">
            <Border x:Name="Bg" CornerRadius="11" Background="#FF18243A" BorderBrush="#FF2B3A55" BorderThickness="1" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#FF1F2C46" />
              <Setter TargetName="Bg" Property="BorderBrush" Value="#FF3A4C6B" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconButton" TargetType="Button">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#FF26344F" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="{StaticResource HoverBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerGhostButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Foreground" Value="#FFE08585" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"
                  BorderBrush="#33F87171" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#22F87171" />
              <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       トグルスイッチ (CheckBox)
       ============================================================ -->
  <Style x:Key="ToggleSwitch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Width="46" Height="24" Background="Transparent">
            <Border x:Name="Track" CornerRadius="12" Background="#FF1A2740" BorderBrush="#FF2C3C57" BorderThickness="1" />
            <Border x:Name="Fill" CornerRadius="12" Opacity="0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="{StaticResource MintColor}" Offset="0" />
                  <GradientStop Color="{StaticResource CyanColor}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect Color="#FF4ADE80" BlurRadius="12" ShadowDepth="0" Opacity="0.55" />
              </Border.Effect>
            </Border>
            <Grid x:Name="KnobGroup" Width="20" Height="20" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center">
              <Grid.RenderTransform>
                <TranslateTransform x:Name="KnobTransform" X="0" />
              </Grid.RenderTransform>
              <Ellipse Width="18" Height="18" Fill="#FF8FA3BF" />
              <Ellipse x:Name="KnobOn" Width="18" Height="18" Fill="#FF062018" Opacity="0" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Fill" Property="Opacity" Value="1" />
              <Setter TargetName="KnobOn" Property="Opacity" Value="1" />
              <Setter TargetName="KnobGroup" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform X="22" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       セグメント (RadioButton)
       ============================================================ -->
  <Style x:Key="SegmentRadio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource SubTextBrush}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Bg" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" />
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#FF16213A" />
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#FF16323F" />
              <Setter TargetName="Bg" Property="BorderBrush" Value="#664ADE80" />
              <Setter Property="Foreground" Value="{StaticResource MintBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       スライダー
       ============================================================ -->
  <Style x:Key="SliderFillRepeat" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Height="6" CornerRadius="3" VerticalAlignment="Center">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="{StaticResource MintColor}" Offset="0" />
                <GradientStop Color="{StaticResource CyanColor}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderEmptyRepeat" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Height="6" CornerRadius="3" Background="Transparent" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderThumbStyle" TargetType="Thumb">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <Ellipse Width="18" Height="18" Fill="#FF0B111C">
              <Ellipse.Effect>
                <DropShadowEffect Color="#FF000000" BlurRadius="8" ShadowDepth="1" Opacity="0.5" />
              </Ellipse.Effect>
            </Ellipse>
            <Ellipse Width="16" Height="16" Fill="#FFE9EFF9" />
            <Ellipse Width="10" Height="10">
              <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="{StaticResource MintColor}" Offset="0" />
                  <GradientStop Color="{StaticResource CyanColor}" Offset="1" />
                </LinearGradientBrush>
              </Ellipse.Fill>
            </Ellipse>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="EcoSlider" TargetType="Slider">
    <Setter Property="Height" Value="26" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent">
            <Border Height="6" CornerRadius="3" Background="{StaticResource TrackBrush}" VerticalAlignment="Center" />
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillRepeat}" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyRepeat}" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource SliderThumbStyle}" />
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       テキストボックス
       ============================================================ -->
  <Style x:Key="EcoTextBox" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="CaretBrush" Value="{StaticResource MintBrush}" />
    <Setter Property="SelectionBrush" Value="#664ADE80" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Height" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" CornerRadius="9" Background="{StaticResource InputBrush}" BorderBrush="#FF263450" BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Padding="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="#804ADE80" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       スクロールバー
       ============================================================ -->
  <Style x:Key="EcoThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border CornerRadius="3" Background="#FF2A3A55" Margin="2,0" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource EcoThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SliderEmptyRepeat}" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SliderEmptyRepeat}" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Width" Value="Auto" />
              <Setter Property="Height" Value="8" />
              <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       ツールチップ
       ============================================================ -->
  <Style TargetType="ToolTip">
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="#FF16213A" BorderBrush="#FF2E3E5A" BorderThickness="1" CornerRadius="8" Padding="9,6" MaxWidth="300">
            <Border.Effect>
              <DropShadowEffect Color="#FF000000" BlurRadius="12" ShadowDepth="2" Opacity="0.45" />
            </Border.Effect>
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================================================
       コンテキストメニュー
       ============================================================ -->
  <Style x:Key="EcoMenuSeparator" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Background="#FF243149" Margin="12,4" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="EcoMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="{StaticResource FontText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,7" Margin="4,1">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
              <TextBlock x:Name="Check" Grid.Column="1" Text="✓" Visibility="Collapsed" FontWeight="Bold"
                         Foreground="{StaticResource MintBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
