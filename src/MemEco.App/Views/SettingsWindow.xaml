<Window x:Class="MemEco.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MemEco.App.Views"
        Title="MemEco 設定" Width="720" Height="640"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        Background="#FF0B111C" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"
                  CornerRadius="18" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
    <views:SettingsPanel />
  </Grid>
</Window>
